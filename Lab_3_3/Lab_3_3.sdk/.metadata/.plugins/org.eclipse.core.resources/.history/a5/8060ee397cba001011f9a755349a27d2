//AXI GPIO driver
#include "xgpio.h"
#include <stdio.h>

//send data over UART
#include "xil_printf.h"

//information about AXI peripherals
#include "xparameters.h"

int main()
{
	XGpio gpio;
	u32 btn, led;
	int num = 0;
	char res;
	int value = 0;

	XGpio_Initialize(&gpio, 0);

	//XGpio_SetDataDirection(&gpio, 2, 0x00000000); // set LED GPIO channel tristates to All Output
	//XGpio_SetDataDirection(&gpio, 1, 0xFFFFFFFF); // set BTN GPIO channel tristates to All Input

	while (1)
	{
		xil_printf("\rPlease enter a number.\n\r");
		while(1) {
			res = getchar();

			if (res == "\r" || res == "\n") break;

	//		xil_printf("You typed: %d", res-48);

			if (res >= '0' && res <= '9') {
				value = value * 10 + (res - '0');
			}
		}

		xil_printf("You typed: %d\n", value);
	}



}
